# Copy to server/.env (read by docker compose) or export in your shell.
# All values have safe dev defaults in application.yml except where noted.

SPRING_PROFILES_ACTIVE=dev
PORT=8080

# JDBC URL — Neon/Supabase give postgres://user:pass@host/db; convert to:
# jdbc:postgresql://host/db?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/connecthub
DATABASE_USERNAME=connecthub
DATABASE_PASSWORD=connecthub

# REQUIRED in prod: base64 of >= 32 random bytes  (openssl rand -base64 48)
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
# Lax is correct when the SPA reaches the API same-origin (Vite proxy / Vercel rewrites).
COOKIE_SAME_SITE=Lax

# Comma-separated origin patterns, e.g. https://connecthub.vercel.app,https://*.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Google OAuth2 — optional; the "Continue with Google" button only appears when both are set.
# Authorized redirect URI to register in Google Cloud Console:
#   dev:  http://localhost:5173/login/oauth2/code/google
#   prod: https://<your-vercel-domain>/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to {baseUrl}/login/oauth2/code/google; set explicitly in prod.
GOOGLE_REDIRECT_URI=

# Where images are stored when Cloudinary isn't configured (dev only).
UPLOAD_DIR=./uploads

# Cloudinary — when unset, images are stored on local disk and served from /uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
