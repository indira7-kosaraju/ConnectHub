{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://connecthub-api.onrender.com/api/:path*" },
    { "source": "/oauth2/:path*", "destination": "https://connecthub-api.onrender.com/oauth2/:path*" },
    { "source": "/login/oauth2/:path*", "destination": "https://connecthub-api.onrender.com/login/oauth2/:path*" },
    { "source": "/uploads/:path*", "destination": "https://connecthub-api.onrender.com/uploads/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
