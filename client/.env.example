# Leave VITE_API_URL empty to call the API same-origin (recommended):
#   dev  -> Vite proxies /api, /oauth2, /login/oauth2 and /uploads to http://localhost:8080
#           (override with API_PROXY_TARGET)
#   prod -> vercel.json rewrites the same paths to the Render backend
# Set it only if you deliberately want cross-origin calls (needs SameSite=None cookies).
VITE_API_URL=

# WebSocket (SockJS) endpoint. Vercel rewrites can't proxy WebSockets, so in prod point this
# straight at the backend, e.g. https://connecthub-api.onrender.com/ws
VITE_WS_URL=http://localhost:8080/ws
